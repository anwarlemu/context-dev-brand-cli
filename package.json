{
  "name": "context-ds",
  "version": "2.0.0",
  "description": "Make any website or app look like Context.dev, and keep coding agents on it.",
  "type": "module",
  "bin": {
    "context-ds": "./bin.js"
  },
  "files": [
    "bin.js",
    "dist",
    "brand",
    "build"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-brand.mjs",
    "test": "vitest run",
    "ci": "npm run build && node scripts/ci-limits.mjs && vitest run",
    "prepare": "tsc -p tsconfig.json && node scripts/build-brand.mjs",
    "release": "sh scripts/release.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@babel/parser": "^7.29.9",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
