{
  "name": "context-ds",
  "version": "2.1.0",
  "description": "Context.dev components, tokens, and checks for agents building pages and interfaces.",
  "type": "module",
  "bin": {
    "context-ds": "./bin.js"
  },
  "files": [
    "bin.js",
    "dist",
    "brand",
    "build",
    "r"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "doctor": "react-doctor apps/www --scope full --verbose",
    "doctor:library": "react-doctor --project registry --scope full --verbose",
    "check:docs": "node scripts/check-docs.mjs",
    "check:library": "node scripts/check-library.mjs",
    "build": "tsc -p tsconfig.json && node scripts/build-brand.mjs",
    "test": "vitest run",
    "ci": "npm run build && node scripts/ci-limits.mjs && npm run registry && vitest run",
    "prepare": "node -e \"process.exit(process.env.VERCEL ? 0 : 1)\" || (tsc -p tsconfig.json && node scripts/build-brand.mjs)",
    "release": "sh scripts/release.sh",
    "registry": "tsx scripts/build-registry.ts && node scripts/build-shadcn.mjs",
    "audit:references": "tsx scripts/audit-references.ts",
    "check:references": "node scripts/check-references.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@babel/parser": "^7.29.9",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5",
    "get-tsconfig": "4.14.3",
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-typescript": "7.29.9",
    "diff": "^8.0.2"
  },
  "optionalDependencies": {
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "yaml": "^2.8.1",
    "@types/babel__core": "^7.20.5",
    "postcss": "^8.5.23"
  },
  "workspaces": [
    "apps/www"
  ]
}
