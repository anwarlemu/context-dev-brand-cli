{
  "color": {
    "bg": {
      "canvas": {
        "$type": "color",
        "$value": "{color.app.canvas}",
        "$description": "Product page background, under white cards"
      },
      "frame": {
        "$type": "color",
        "$value": "{color.app.frame}"
      },
      "wash": {
        "$type": "color",
        "$value": "{color.black}",
        "$description": "Hover and pressed wash, always with an opacity: bg-wash/4 hover, bg-wash/6 selected. White in dark"
      },
      "scrim": {
        "$type": "color",
        "$value": "{color.app.scrim}",
        "$description": "Behind a modal"
      },
      "shine": {
        "$type": "color",
        "$value": "{color.app.shine}",
        "$description": "Skeleton shimmer highlight"
      }
    },
    "border": {
      "hairline": {
        "$type": "color",
        "$value": "{color.app.hairline}",
        "$description": "The 1px edge of product cards, frames and popovers"
      }
    },
    "chart": {
      "series-1": {
        "$type": "color",
        "$value": "{color.app.series-1}",
        "$description": "Chart series in fixed order: blue, teal, amber, violet. Red is reserved for errors"
      },
      "series-2": {
        "$type": "color",
        "$value": "{color.app.series-2}"
      },
      "series-3": {
        "$type": "color",
        "$value": "{color.app.series-3}"
      },
      "series-4": {
        "$type": "color",
        "$value": "{color.app.series-4}"
      },
      "alert-strong": {
        "$type": "color",
        "$value": "{color.app.alert-strong}",
        "$description": "Problems in charts, strongest for the most severe"
      },
      "alert": {
        "$type": "color",
        "$value": "{color.app.alert}"
      },
      "alert-soft": {
        "$type": "color",
        "$value": "{color.app.alert-soft}"
      },
      "ok": {
        "$type": "color",
        "$value": "{color.app.ok}",
        "$description": "Successes in status charts"
      },
      "client-error": {
        "$type": "color",
        "$value": "{color.app.client-error}"
      },
      "server-error": {
        "$type": "color",
        "$value": "{color.app.server-error}",
        "$description": "Always stacks on top of client errors"
      }
    }
  }
}