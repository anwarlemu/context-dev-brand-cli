{
  "$description": "Product surfaces (the dashboard). Applied under the .ds-product class. Values are px because the product root is 15px (93.75%) and text stays put while rem spacing scales. Source: context-dashboard globals.css",
  "color": {
    "text": {
      "subtle": {
        "$type": "color",
        "$value": "{color.app.subtle}"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{color.app.line-subtle}"
      }
    }
  },
  "radius": {
    "window": {
      "$type": "dimension",
      "$value": "10px"
    }
  },
  "text": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "56px",
        "lineHeight": 1.15,
        "fontWeight": "{font.weight.medium}",
        "letterSpacing": "0px"
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "28px",
        "lineHeight": 1.2,
        "fontWeight": "{font.weight.medium}",
        "letterSpacing": "0px"
      }
    },
    "h4": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "21px",
        "lineHeight": 1.4,
        "fontWeight": 450,
        "letterSpacing": "0px"
      }
    },
    "h5": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "18px",
        "lineHeight": 1.3,
        "fontWeight": "{font.weight.medium}",
        "letterSpacing": "0px"
      }
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "16px",
        "lineHeight": 1.3,
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "0px"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "15px",
        "lineHeight": 1.3,
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "0px"
      }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "12.6px",
        "lineHeight": 1.3,
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "0px"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "12px",
        "lineHeight": 1.3,
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "0px"
      }
    },
    "micro": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "11px",
        "lineHeight": 1.45,
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "0px"
      }
    },
    "button": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "12.6px",
        "lineHeight": 1.3,
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": "0px"
      }
    }
  }
}