{
  "name": "persona-glyph",
  "type": "visual",
  "title": "Persona glyph",
  "description": "A small picture in white dots on brand blue that melts between two glyphs (what a team builds, then what the API gives it). `MenuGlyph` is the 36px tile the header menus use as icons, held still.",
  "surface": "site",
  "kinds": [],
  "requires": [
    "theme",
    "dot-engine",
    "utils"
  ],
  "packages": [],
  "files": [
    {
      "path": "components/visuals/persona-glyph.tsx",
      "content": "\"use client\";\n\nimport { useCallback, useMemo } from \"react\";\n\nimport { DotStory, type LoadDotStory } from \"@/components/visuals/dot-engine/dot-story\";\nimport { PERSONA_GLYPH_GRID, personaGlyph, type PersonaGlyphName } from \"@/components/visuals/stories/persona-glyphs\";\nimport { cn } from \"@/lib/utils\";\n\n// Cards join the loop this far apart, so neighbors never melt at the same moment.\nconst STAGGER_SECONDS = 0.85;\n\n/**\n * A small picture in white dots on the brand's blue: a glyph for what a team builds or a product does, giving way to\n * one for what the API gives it and back. The site uses it for menu icons, persona cards and use-case links; pass\n * each one's place in its list as `index` so a row of them never changes in step. `still` keeps the glyph. With\n * reduced motion it shows the glyph.\n */\nfunction PersonaGlyph({ name, index = 0, still = false, className }: { name: PersonaGlyphName; index?: number; still?: boolean; className?: string }) {\n  const resting = useMemo(() => ({ cells: personaGlyph(name) }), [name]);\n  const load = useCallback<LoadDotStory>(\n    async (stage) => {\n      const { createPersonaGlyphPlayer } = await import(\"@/components/visuals/persona-glyph-player\");\n      return createPersonaGlyphPlayer(stage, name, index * STAGGER_SECONDS);\n    },\n    [name, index],\n  );\n  return (\n    <span data-slot=\"persona-glyph\" className={cn(\"flex size-14 shrink-0 items-center justify-center rounded-card bg-brand p-2\", className)}>\n      <DotStory grid={PERSONA_GLYPH_GRID} resting={resting} load={load} still={still} className=\"w-full text-white\" />\n    </span>\n  );\n}\n\n/**\n * The header menus' icon: a persona glyph in a 36px blue tile, as the site's Products and Use cases menus draw them.\n * Held still: an icon in a menu should not move while the pointer is over it.\n */\nfunction MenuGlyph({ name, className }: { name: PersonaGlyphName; className?: string }) {\n  return <PersonaGlyph name={name} still className={cn(\"size-9 rounded-control p-2.5\", className)} />;\n}\n\nexport { MenuGlyph, PersonaGlyph, type PersonaGlyphName };\n"
    },
    {
      "path": "components/visuals/persona-glyph-player.ts",
      "content": "import { createBeatStoryPlayer, type StoryPicture } from \"@/components/visuals/dot-engine/dot-story-beats\";\nimport { cellStates, cellsOfStates } from \"@/components/visuals/dot-engine/dot-story-cells\";\nimport type { DotStoryPlayer, DotStoryStage } from \"@/components/visuals/dot-engine/dot-story-player\";\nimport type { GlyphCell } from \"@/components/visuals/dot-engine/dot-glyph-cells\";\nimport { PERSONA_GLYPH_GRID, personaGlyph, personaOutcome, type PersonaGlyphName } from \"@/components/visuals/stories/persona-glyphs\";\n\n/** A persona's glyph, played as a loop: what the team builds gives way to what the API gives it, and back. */\n\n// A glyph this small is mostly one-dot lines, which a melt thins to nothing halfway through; a wave from the\n// middle swaps one glyph for the other without ever emptying the card.\nconst WAVE = { seconds: 0.8, origin: { column: 5, row: 5 } };\nconst OUTCOME_HOLD_SECONDS = 2.2;\nconst GLYPH_HOLD_SECONDS = 2.8;\n\nconst pictureOfCells = (cells: GlyphCell[]): StoryPicture => {\n  const states = cellStates(PERSONA_GLYPH_GRID, cells);\n  return { states, cells: cellsOfStates(PERSONA_GLYPH_GRID, states) };\n};\n\n/** `startsAtSeconds` into the glyph's hold is where this card joins the loop, so a grid of cards does not melt in step. */\nexport function createPersonaGlyphPlayer(stage: DotStoryStage, name: PersonaGlyphName, startsAtSeconds: number): DotStoryPlayer {\n  return createBeatStoryPlayer(stage, {\n    grid: PERSONA_GLYPH_GRID,\n    resting: { beat: 1, heldSeconds: startsAtSeconds % GLYPH_HOLD_SECONDS },\n    beats: [\n      { picture: pictureOfCells(personaOutcome(name)), arrival: { kind: \"waves\", ...WAVE }, holdSeconds: OUTCOME_HOLD_SECONDS },\n      { picture: pictureOfCells(personaGlyph(name)), arrival: { kind: \"waves\", ...WAVE }, holdSeconds: GLYPH_HOLD_SECONDS },\n    ],\n  });\n}\n"
    },
    {
      "path": "components/visuals/stories/persona-glyphs.ts",
      "content": "import { glyphCellsFromRows, type GlyphCell } from '@/components/visuals/dot-engine/dot-glyph-cells';\nimport type { DotGrid } from '@/components/visuals/dot-engine/dot-morph-dots';\n\n/**\n * The small pictures on the persona cards, in the brand dot grid: for each kind of team, a glyph for what it builds\n * and a second for what the API gives it, which the first gives way to and returns from.\n */\n\nexport const PERSONA_GLYPH_GRID: DotGrid = { columns: 11, rows: 11, pitch: 10, dotRadius: 3.7, ringStroke: 1.3, haloRadius: 0 };\n\n// Every drawing, one string per row: `#` a solid dot, `o` a ring.\nconst ART = {\n\tcylinder: ['  #######  ', ' #       # ', ' ######### ', ' #       # ', ' #       # ', ' ######### ', ' #       # ', ' #       # ', ' ######### ', ' #       # ', '  #######  '],\n\tchunks: ['### ### ###', '### ### ###', '### ### ###', '           ', '### ooo ###', '### ooo ###', '### ooo ###', '           ', '### ### ###', '### ### ###', '### ### ###'],\n\trobot: ['     #     ', '     #     ', ' ######### ', ' #       # ', ' # ## ## # ', ' # ## ## # ', ' #       # ', ' #  ###  # ', ' #       # ', ' ######### ', '  ##   ##  '],\n\tbrowser: ['###########', '#o o o    #', '###########', '#         #', '# ####### #', '#         #', '# ###     #', '#         #', '# #####   #', '#         #', '###########'],\n\tmagnifier: ['  #####    ', ' #ooooo#   ', '#ooooooo#  ', '#ooooooo#  ', '#ooooooo#  ', '#ooooooo#  ', ' #ooooo#   ', '  ######   ', '       ##  ', '        ## ', '         ##'],\n\tbubble: [' ######### ', '#         #', '# ####### #', '#         #', '# #####   #', '#         #', ' ######### ', '   ##      ', '  ##       ', '  #        ', '           '],\n\tshield: ['     #     ', '  #######  ', ' #ooooooo# ', ' #ooooooo# ', ' #ooooooo# ', ' #ooooooo# ', ' #ooooooo# ', '  #ooooo#  ', '   #ooo#   ', '    ###    ', '     #     '],\n\teye: ['           ', '           ', '   #####   ', ' ##     ## ', '#   ###   #', '#  #####  #', '#   ###   #', ' ##     ## ', '   #####   ', '           ', '           '],\n\tbook: ['           ', ' #### #### ', '#    #    #', '# ## # ## #', '#    #    #', '# ## # ## #', '#    #    #', '# ## # ## #', '#    #    #', ' #### #### ', '           '],\n\tlayers: ['     #     ', '   ## ##   ', ' ##     ## ', '   ## ##   ', ' #   #   # ', '  ##   ##  ', '    ###    ', ' #       # ', '  ##   ##  ', '    ###    ', '           '],\n\tfile: [' #######   ', ' #     ##  ', ' #      ## ', ' # ###   # ', ' #       # ', ' # ##### # ', ' #       # ', ' # ###   # ', ' #       # ', ' #       # ', ' ######### '],\n\tchecklist: ['##  #######', '##         ', '           ', '##  #####  ', '##         ', '           ', '##  #######', '##         ', '           ', '##  ####   ', '##         '],\n\tbolt: ['      ##   ', '     ##    ', '    ##     ', '   ###     ', '  ######## ', '     ###   ', '     ##    ', '    ##     ', '   ##      ', '  ##       ', '  #        '],\n\tpencil: ['        ## ', '       ####', '      ## ##', '     ## ## ', '    ## ##  ', '   ## ##   ', '  ## ##    ', ' # ###     ', ' #  #      ', ' ###       ', '           '],\n\tglobe: ['   #####   ', '  # # # #  ', ' #  # #  # ', '###########', '#  #   #  #', '#  #   #  #', '#  #   #  #', '###########', ' #  # #  # ', '  # # # #  ', '   #####   '],\n\timage: ['###########', '#         #', '#      ## #', '#      ## #', '#  #      #', '# ###   # #', '#####  ####', '###########', '###########', '###########', '###########'],\n\tbriefcase: ['           ', '   #####   ', '   #   #   ', '###########', '#ooooooooo#', '#ooooooooo#', '#####o#####', '#         #', '#         #', '###########', '           '],\n\tcontactCard: ['###########', '#         #', '#  ##     #', '# #### ## #', '#  ##     #', '# #### ## #', '# ####    #', '#      ## #', '#         #', '###########', '           '],\n\ttower: ['  #######  ', '  #     #  ', '  # # # #  ', '  #     #  ', '  # # # #  ', '  #     #  ', '  # # # #  ', '  #     #  ', '  # ### #  ', '  # # # #  ', '###########'],\n\ttiles: ['##### #####', '#   # #   #', '# # # # # #', '#   # #   #', '##### #####', '           ', '##### #####', '#   # #   #', '# # # # # #', '#   # #   #', '##### #####'],\n\tbars: ['         ##', '         ##', '      ## ##', '      ## ##', '      ## ##', '   ## ## ##', '   ## ## ##', '## ## ## ##', '## ## ## ##', '## ## ## ##', '###########'],\n\ttrend: ['       ####', '         ##', '        # #', '       #  #', '   #  #    ', '  # ##     ', ' #         ', '#          ', '           ', '###########', '           '],\n\tchain: ['           ', '  ####     ', ' #    #    ', '#   ####   ', '#  #  # #  ', '#  #  #  # ', ' # #  #  # ', '  ####   # ', '   #    #  ', '    ####   ', '           '],\n\tlogo: ['    #######', '    #######', '    #######', '  ###ooo###', ' ####ooo###', '#####ooo###', '#######    ', '#######    ', ' #####     ', '  ###      ', '           '],\n\tstorefront: [' ######### ', ' #ooooooo# ', '###########', '# # # # # #', ' ######### ', ' #       # ', ' # ##  # # ', ' # ##  # # ', ' # ##    # ', ' # ##    # ', ' ######### '],\n\ttag: ['           ', '           ', '  ######## ', ' ##      # ', '##  ##   # ', '#   ##   # ', '##       # ', ' ##      # ', '  ######## ', '           ', '           '],\n\tscroll: [' ########  ', '#        # ', ' # ##### # ', ' #       # ', ' # ##### # ', ' #       # ', ' # ###   # ', ' #       # ', ' #       ##', ' #        #', '  ######## '],\n\ttick: ['           ', '          #', '         ##', '        ## ', '       ##  ', '#     ##   ', '##   ##    ', ' ## ##     ', '  ###      ', '   #       ', '           '],\n\tsignedShield: ['     #     ', '  #######  ', ' ######### ', ' #######o# ', ' ######o## ', ' #o###o### ', ' ##o#o#### ', '  ##o####  ', '   #####   ', '    ###    ', '     #     '],\n\tkey: ['           ', '           ', '  ###      ', ' #   #     ', '#     #####', '#     #  # ', ' #   #     ', '  ###      ', '           ', '           ', '           '],\n\tclock: ['   #####   ', '  #     #  ', ' #   #   # ', '#    #    #', '#    #    #', '#    ###  #', '#         #', '#         #', ' #       # ', '  #     #  ', '   #####   '],\n\tlog: ['           ', '# #########', '           ', '# ######   ', '           ', '# #########', '           ', '# #####    ', '           ', '# ######## ', '           '],\n\twand: ['        # #', '         # ', '        # #', '       #   ', '      #    ', '     #     ', '    #      ', '   #       ', '  #        ', ' #         ', '#          '],\n\tbell: ['     #     ', '    ###    ', '   #####   ', '  #######  ', '  #######  ', '  #######  ', '  #######  ', ' ######### ', '###########', '           ', '    ###    '],\n\toffice: ['   #####   ', '   #   #   ', '   # # #   ', '   #   ####', '   # # #  #', '   #   # ##', '   # # #  #', '   #   # ##', '   # # #  #', '   #   #  #', '###########'],\n\tbust: ['   #####   ', '  #     #  ', '  #     #  ', '  #     #  ', '   #####   ', '           ', '  #######  ', ' #       # ', '#         #', '#         #', '###########'],\n\trocket: ['     #     ', '    ###    ', '   #####   ', '   ## ##   ', '   #####   ', '   #####   ', '  #######  ', ' ## ### ## ', ' #  ###  # ', '    # #    ', '     #     '],\n\tform: ['###########', '#         #', '# ####### #', '#         #', '# #####   #', '#         #', '# ####### #', '#         #', '#     ### #', '#     ### #', '###########'],\n\tdashboard: ['###########', '# #       #', '# # ##### #', '# #       #', '# # ## ## #', '# # ## ## #', '# #       #', '# # ##### #', '# #       #', '# #       #', '###########'],\n\tswatches: ['##### ooooo', '##### ooooo', '##### ooooo', '##### ooooo', '##### ooooo', '           ', 'ooooo #####', 'ooooo # # #', 'ooooo ## ##', 'ooooo # # #', 'ooooo #####'],\n\tpeople: ['  ###   ## ', ' #####  ## ', ' ##### ####', '  ###  ####', '        ## ', ' #####     ', '####### ###', '###########', '###########', '###########', '           '],\n\tmail: ['           ', '###########', '##       ##', '# #     # #', '#  #   #  #', '#   # #   #', '#    #    #', '#         #', '#         #', '###########', '           '],\n\tflow: ['###        ', '###        ', '###        ', ' #         ', ' #     ### ', ' ######### ', ' #     ### ', ' #         ', '###        ', '###        ', '###        '],\n\tmegaphone: ['         ##', '       ####', '     ######', '###########', '###########', '###########', '     ######', '  ##   ####', '  ##     ##', '  ##       ', '           '],\n\tpen: ['     #     ', '    ###    ', '    ###    ', '   ## ##   ', '   ## ##   ', '  ##   ##  ', '  ## # ##  ', '  #######  ', '   #####   ', '   #####   ', '    ###    '],\n\tslide: ['###########', '#         #', '# ###     #', '#      ## #', '# ##   ## #', '#    # ## #', '###########', '     #     ', '    ###    ', '   #   #   ', '  #     #  '],\n\tbrandedDoc: [' ######### ', ' #       # ', ' # ##    # ', ' # ##    # ', ' #       # ', ' # ##### # ', ' #       # ', ' # ##### # ', ' #       # ', ' # ##    # ', ' ######### '],\n\tpalette: ['   #####   ', '  #######  ', ' ##o###o## ', '####### ###', '#o#####    ', '######     ', '#o#####    ', '########## ', ' ##o###o## ', '  #######  ', '   #####   '],\n\tpie: ['   #####   ', '  ###   #  ', ' ####    # ', '#####     #', '#####     #', '###########', '#         #', '#         #', ' #       # ', '  #     #  ', '   #####   '],\n\tshare: ['        ###', '        ###', '      ##   ', '    ##     ', '###        ', '###        ', '    ##     ', '      ##   ', '        ###', '        ###', '           '],\n\tspark: ['     #     ', '     #     ', '    ###    ', '    ###    ', '  #######  ', '###########', '  #######  ', '    ###    ', '    ###    ', '     #     ', '     #     '],\n\ttextLines: ['###########', '           ', '########   ', '           ', '###########', '           ', '######     ', '           ', '###########', '           ', '#######    '],\n} satisfies Record<string, string[]>;\n\n// Each card's pair: what the team builds or the feature is, then what the API gives it. The last five of the first\n// group belong to feature cards rather than teams, and the last five of all to the products in the header's menu.\nconst PAIRS = {\n\tdatabase: ['cylinder', 'chunks'],\n\tbot: ['robot', 'browser'],\n\tsearch: ['magnifier', 'bubble'],\n\tshield: ['shield', 'eye'],\n\tbook: ['book', 'layers'],\n\tfile: ['file', 'checklist'],\n\tbolt: ['bolt', 'pencil'],\n\tglobe: ['globe', 'image'],\n\tbriefcase: ['briefcase', 'contactCard'],\n\tbuilding: ['tower', 'tiles'],\n\tchart: ['bars', 'trend'],\n\tlink: ['chain', 'logo'],\n\tstore: ['storefront', 'tag'],\n\tscroll: ['scroll', 'tick'],\n\tsigned: ['signedShield', 'key'],\n\thistory: ['clock', 'log'],\n\twand: ['wand', 'bell'],\n\tcompany: ['office', 'logo'],\n\tperson: ['bust', 'contactCard'],\n\trocket: ['rocket', 'form'],\n\ttheme: ['dashboard', 'swatches'],\n\tportal: ['browser', 'logo'],\n\tteam: ['people', 'mail'],\n\ttenants: ['layers', 'swatches'],\n\tagency: ['people', 'swatches'],\n\twhitelabel: ['flow', 'tag'],\n\temail: ['mail', 'swatches'],\n\tdesign: ['pen', 'slide'],\n\tcampaign: ['megaphone', 'mail'],\n\tdocument: ['file', 'brandedDoc'],\n\tcreative: ['palette', 'layers'],\n\treport: ['pie', 'bars'],\n\tsocial: ['share', 'image'],\n\tgenerate: ['spark', 'textLines'],\n\timagegen: ['image', 'swatches'],\n\twriting: ['pencil', 'textLines'],\n\tslides: ['slide', 'swatches'],\n\tchat: ['robot', 'bubble'],\n\toutreach: ['bubble', 'mail'],\n\tscrape: ['browser', 'textLines'],\n\tmap: ['globe', 'log'],\n\tbatches: ['layers', 'checklist'],\n\tmonitor: ['clock', 'bell'],\n\tstyleguide: ['palette', 'swatches'],\n} satisfies Record<string, [keyof typeof ART, keyof typeof ART]>;\n\nexport type PersonaGlyphName = keyof typeof PAIRS;\n\nexport const personaGlyph = (name: PersonaGlyphName): GlyphCell[] => glyphCellsFromRows(ART[PAIRS[name][0]]);\nexport const personaOutcome = (name: PersonaGlyphName): GlyphCell[] => glyphCellsFromRows(ART[PAIRS[name][1]]);\n"
    }
